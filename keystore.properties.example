# Copy to `keystore.properties` (git-ignored) and fill in, OR set the equivalent
# env vars (COUNTYLINE_KEYSTORE, COUNTYLINE_KEYSTORE_PASSWORD, COUNTYLINE_KEY_ALIAS,
# COUNTYLINE_KEY_PASSWORD) for CI.
#
# Generate the upload keystore once (see RELEASING.md):
#   keytool -genkeypair -v -keystore upload-keystore.jks -alias upload \
#     -keyalg RSA -keysize 4096 -validity 10000

# Path to the keystore, relative to the repo root.
storeFile=upload-keystore.jks
storePassword=CHANGE_ME
keyAlias=upload
keyPassword=CHANGE_ME
